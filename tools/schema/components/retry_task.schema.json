{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Retry Task Component Schemas",
    "description": "Parameter definitions for the RetryTaskAction custom action.",
    "$defs": {
        "RetryTaskParam": {
            "type": "object",
            "required": [
                "task"
            ],
            "properties": {
                "task": {
                    "type": "string",
                    "minLength": 1
                },
                "retry": {
                    "type": "integer",
                    "minimum": 0
                },
                "delay_ms": {
                    "type": "integer",
                    "minimum": 0
                },
                "failure_key": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "unevaluatedProperties": false
        }
    }
}
