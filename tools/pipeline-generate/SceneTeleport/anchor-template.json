{
    "${Node}": {
        "desc": "${Desc}",
        "recognition": "Custom",
        "custom_recognition": "MapFind",
        "custom_recognition_param": {
            "zone": "${Zone}",
            "icon": "TeleportAnchor",
            "at": "${At}"
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RepeatUntilFoundAction",
                "custom_action_param": {
                    "action": "Click",
                    "wait_nodes": [
                        "__ScenePrivateMapTeleportChoose",
                        "__ScenePrivateMapMarkerPanelClose",
                        "__ScenePrivateMapTeleportConfirm",
                        "__ScenePrivateMapTeleportSuccess"
                    ],
                    "repeat_count": 3,
                    "interval_ms": 3000,
                    "refresh_current_recognition": false
                }
            }
        },
        "anchor": {
            "__ScenePrivateMapTeleportPickAnchor": ""
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[JumpBack]__ScenePrivateMapTeleportChoose",
            "[JumpBack]__ScenePrivateMapMarkerPanelClose",
            "__ScenePrivateMapTeleportConfirm",
            "__ScenePrivateMapTeleportSuccess"
        ],
        "focus": {
            "Node.Action.Succeeded": {
                "trace": true
            },
            "Node.Action.Failed": {
                "trace": true
            }
        }
    }
}
