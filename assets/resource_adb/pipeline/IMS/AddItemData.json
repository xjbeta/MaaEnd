{
    "IMSA3MouseMoveReset": {
        "desc": "ADB 无鼠标光标遮挡，识别前无需移动",
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0
    },
    // ADB 奖励/购买成功界面的确认按钮是直径 40px 的圆形，识别框是 44×45 的外接矩形，
    // 四角落在圆形按钮之外的遮罩上；默认 target 会在框内随机取点，取到框角时点击被吞，
    // 界面不关闭（08:55 稳定物资购买后卡在“购买成功”界面 20s）。
    // 用 target_offset 把 44×45 收成 2×3 再取中心：框中心与圆钮同心，不随面板高度变化。
    // 该按钮在 ADB 上有 y=586 / y=628 两档（奖励面板行数不同，见上游 #7128），固定点
    // [640,608] 只覆盖 586 档；628 档没有实机样本，此处按识别框中心作防御性修正。
    "AddItemDataCloseRewards": {
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    21,
                    21,
                    -42,
                    -42
                ]
            }
        }
    }
}
