{
    // 老设备 + 虚拟屏：18~34 FPS，界面过渡比桌面慢 1~2 秒。
    // 「进入大世界成功」的稳定窗口原为 800 ms / 超时 2000 ms，
    // 低帧率下容易在过渡帧上就判定稳定，随后立刻读错状态。
    // 放宽到 1200 ms / 3500 ms：只在画面还在动时多等，静止画面几乎不增加耗时。
    "__ScenePrivateAnyEnterWorldSuccess": {
        "pre_wait_freezes": {
            "time": 1200,
            "target": [
                70,
                80,
                70,
                60
            ],
            "timeout": 3500
        }
    }
}
