        // 老设备兜底：点一次 ⊗ 从「菜单总列表」退到地图后，还差一次退出；
        // 等不到大世界时复用 ADB 的触摸版 __ScenePrivateAnyExit（右上角 X / 返回 / 手表），
        // 而不是空等 20 s 超时。
        // 基础节点的 target 是相对识别框的偏移，而这个界面的 InMenuList 识别框
        // 是底部 ENDFIELD 标志 [686,619,145,44]，`[-60,40]` 算出来落在 [626,659]，
        // 点的是底边而不是右上角 ⊗。这里不再盲点，改由下面的专用节点点图标本身；
        // 因此本节点改成 DoNothing，也不再需要 target（DoNothing 不允许带 target）。
        "action": "DoNothing",
        "next": [
            "[JumpBack]SceneNoticeRewardsUpgrade",
            "__ScenePrivateAnyEnterWorldSuccess",
            "[JumpBack]__ScenePrivateMenuCloseADB",
            "[JumpBack]__ScenePrivateAnyExit"
        ]
    },
    // 菜单总列表右上角 ⊗。通用 CloseButtonType1 在这套 UI 上只有 0.21~0.37，
    // 5 个变体全部打不中；这里用 11-21 11:29 失败帧原位裁的 34×34 模板兜底。
    "__ScenePrivateMenuCloseADB": {
        "desc": "菜单总列表右上角 ⊗（ADB 原位裁剪模板）",
        "recognition": "TemplateMatch",
        "roi": [
            1160,
            0,
            120,
            110
        ],
        "template": "SceneManager/MenuCloseADB.png",
        "threshold": 0.9,
        "action": "Click"
    },
    // 老设备：进入任务界面的稳定窗口原为 100 ms，低帧率下按钮还在淡入就判定成功，
    // 随后的点击容易落空；放宽到 300 ms。
    "__ScenePrivateAnyEnterMenuMissionSuccess": {
        "pre_wait_freezes": {
            "time": 300,
            "target": [
                0,
                0,
                200,
                100
            ]
        }
    }
