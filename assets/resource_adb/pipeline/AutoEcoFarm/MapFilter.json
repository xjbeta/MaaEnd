{
    // ADB：仅覆盖左列“农牧相关”词条。若未来版本修改了此选项位置，需重新测量 roi、或补充 OCR 识别。
    // “农牧相关”与“装饰物品”图标相同，为减少维护难度，使用 roi 仅覆盖左列“农牧相关”词条，避免误触“装饰物品”。
    // 选中后整行转为浅底，未选中态的图标模板 FarmingFilter.png 不再命中，因此确认节点不能拿本节点的
    // 识别框当 roi（此前即因 roi 解析失败，重试点击把复选框来回翻转）。本节点只点一次，之后由
    // __AutoEcoFarmFilterFarmingSelected 在节点 timeout 内轮询确认；点空则任务失败，不再盲点。
    // 点击框必须正好落在右侧的圆形单选钮上：模板命中框是左端的类目图标（如 [53,583,19,19]），
    // 单选钮在 [194,582,22,22]（见 FarmingSelected 实测框）。Click 的 target_offset 形如
    // [dx,dy,dw,dh]，会给框的宽高各加上 dw/dh，命中点在该矩形内随机（越靠中心概率越高）。
    // 因此 offset 取 [141,-1,3,3] → [194,582,22,22]；此前的 [142,-1,19,19] 会把矩形撑到
    // [195,582,38,38]，下沿/右沿越过单选钮（钮 y 582-604、x 194-216），随机点可落到 row 外
    // 导致点击不生效（07:38:47 落在 [221,617]，已滑出该行）。
    "__AutoEcoFarmFilterSelectFarming": {
        "roi": [
            42,
            60,
            200,
            555
        ],
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    141,
                    -1,
                    3,
                    3
                ]
            }
        }
    },
    // 复选框列的绝对 roi：列表滚动只改变行的 y，勾选框的 x 固定在 195 附近（720p）。
    // 进入本节点前 __AutoEcoFarmFilterClearAll 已清空其它勾选，整列只可能有“农牧相关”一个勾。
    "__AutoEcoFarmFilterFarmingSelected": {
        // 与 base 同形写在 recognition.param 内，避免扁平字段与嵌套字段叠加时 roi_offset 被 base 的
        // [104,-10,24,20] 再偏移一次。
        "recognition": {
            "param": {
                "roi": [
                    140,
                    60,
                    140,
                    580
                ],
                "roi_offset": [
                    0,
                    0,
                    0,
                    0
                ],
                // 模板由 06:41 失败截图原位裁切，实测原位 1.0、偏移 1 px 掉到 0.84，故阈值留到 0.8。
                "threshold": 0.8
            }
        }
    },
    "__AutoEcoFarmFilterScrollDown": {
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    120,
                    598
                ],
                "end": [
                    120,
                    72
                ],
                "duration": 400
            }
        }
    },
    "__AutoEcoFarmFilterNoProgress": {
        "roi": [
            42,
            56,
            388,
            554
        ]
    },
    // ADB：低帧率下「标记显示管理」这一行的点击会被输入层吞掉。2026-11-06 06:21:28.9 认清
    // 并点击后，__AutoEcoFarmFilterClearAll 直到 06:21:48.9 节点 20s 超时仍未命中：
    // on_error/2026.11.06-06.21.48.922___AutoEcoFarmFilterOpen.png 里面板仍处于收起态，
    // 「标记显示管理」四个字可见但未展开。原节点只点一次、next 仅挂 ClearAll，失败后框架
    // 只会反复重跑 next 列表，不会补点。这里改为同点重试：点击 → 等 ClearAll 命中即停，
    // 最多 3 次、每次 3s（500ms 轮询）；识别与 roi 沿用 base 节点。
    "__AutoEcoFarmFilterOpen": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RepeatUntilFoundAction",
                "custom_action_param": {
                    "action": "Click",
                    "wait_nodes": [
                        "__AutoEcoFarmFilterClearAll"
                    ],
                    "repeat_count": 3
                }
            }
        }
    }
}
