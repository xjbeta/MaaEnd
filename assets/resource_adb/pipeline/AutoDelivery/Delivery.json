{
    // 老设备 + 虚拟屏（1280×720 / 240dpi，18~37 FPS）的送货交互容差。
    // 全部只放宽「过渡判定」，不改变判定逻辑：画面静止时不增加耗时。
    //
    // 1) 是否进入对话：基础阈值 0.6 太松。
    //    2026-11-21 11:44 实机，左上角 [57,31,46,29] 的普通元素以 0.671 命中，
    //    RepeatUntilFoundAction 立刻以为对话已打开，转而等跳过按钮 → 6 s 后失败。
    //    真对话帧：11:35 为 0.846，12:09 为 0.845；假命中 0.27~0.69。
    //    0.78 落在两者之间。
    "AutoDeliveryInChatDialog": {
        "threshold": 0.78
    },
    // 2) 提交货物：重复点击 5 → 8 次；节点超时 600 ms → 6 s。
    //    本机点击后对话要 1.8~3.2 s 才渲染（11:35 用 1.8 s，12:09 用 3.24 s），
    //    600 ms 的窗口连一次「点击 → 判定」都转不完。
    "AutoDeliverySubmitGoods": {
        "custom_action_param": {
            "custom_action": "AutoAltClickAction",
            "wait_nodes": [
                "AutoDeliveryInChatDialog",
                "AutoDeliveryCloseRewardDialog"
            ],
            "repeat_count": 8
        },
        "timeout": 6000
    },
    // 3) 跳过按钮：对话刚弹出时按钮还在淡入，200 ms 冻结判定会在低帧率下反复判空。
    "AutoDeliveryCheckSkipChatReady": {
        "pre_wait_freezes": 500
    }
}
