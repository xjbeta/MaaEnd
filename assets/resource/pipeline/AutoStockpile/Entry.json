{
    "AutoStockpileElasticGoodsButton": {
        "desc": "弹性物资调度黑白双煞",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "AutoStockpileElasticGoods",
                    "AutoStockpileElasticGoodsSelected"
                ]
            }
        }
    },
    // 切换校验 + 补点：点击弹性 tab 后必须确认 tab 真的变浅（选中态）。
    //
    // 这里用顶部 tab 的模板而不是侧边栏图标：`ElasticGoodsButtonSelected` 在
    // 点击前 0.416、点击后 0.969，区分度足够；而侧边栏两张模板近乎互补
    // （未选中 median=70、选中 median=253），在浅色空白处也能得 0.99，
    // 2026-11-19 11:02:51 的 0.993 就落在两个图标之间的空白 [25,323,35,35]。
    //
    // 原实现把 `ElasticGoodsSelected` 放在 SelectMarket 的识别条件里，
    // 而它本身就是「切换成功」的结果 —— 一旦那一次点击被吞，条件永远不成立，
    // 于是 20 s 空转 2418 次失败。现在改成「先点，再校验，失败补点」。
    //
    // pre_wait_freezes 等 tab 区域画面稳定后再判定：2026-11-19 11:50:16 点击后
    // 首次识别在 +80 ms 就失败、+174 ms 才命中，属于界面尚未刷新完的时序竞争。
    // 用冻结等待代替固定延迟，界面一变就立刻继续，不浪费也不误判。
    "AutoStockpileEnsureElasticTab": {
        "desc": "确认已切到弹性物资 tab，未切换则重点弹性 tab",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AutoStockpileElasticGoodsSelected"
                ]
            }
        },
        "pre_wait_freezes": {
            "time": 100,
            "target": [
                340,
                56,
                162,
                116
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockpileSelectMarket"
        ],
        "on_error": [
            "AutoStockpileSwitchElasticTab"
        ]
    },
    "AutoStockpileSwitchElasticTab": {
        "desc": "点击弹性需求物资 tab 并等待切换生效，最多 3 次",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AutoStockpileElasticGoodsButton"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RepeatUntilFoundAction",
                "custom_action_param": {
                    "action": "Click",
                    "wait_nodes": [
                        "AutoStockpileElasticGoodsSelected"
                    ],
                    "repeat_count": 3,
                    "interval_ms": 3000
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockpileSelectMarket"
        ],
        "on_error": [
            "AutoStockpileTabSwitchFailed"
        ]
    },
    "AutoStockpileTabSwitchFailed": {
        "desc": "切换弹性物资 tab 连续失败：停下，避免在稳定物资页继续买错货",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "FalseAction"
            }
        },
        "post_delay": 0,
        "rate_limit": 0
    },
    "AutoStockpileSelectMarket": {
        "desc": "将所有可购买物品展示在窗口中",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AutoStockpileFindMarketSidebar"
                ]
            }
        },
        "pre_wait_freezes": 80,
        "pre_delay": 0,
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    5,
                    5,
                    -10,
                    -10
                ]
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockpileEnaureElasticClicked"
        ]
    },
    "AutoStockpileResetShelf": {
        "desc": "重置货架位置：点击市场入口（整页顶部时为未选中/灰色态），让列表跳回市场段顶部",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AutoStockpileFindMarketSidebar",
                    "AutoStockpileElasticGoodsSelected"
                ]
            }
        },
        "pre_wait_freezes": 80,
        "pre_delay": 0,
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    5,
                    5,
                    -10,
                    -10
                ]
            }
        },
        "post_wait_freezes": {
            "time": 100,
            "target": [
                63,
                162,
                1177,
                553
            ],
            "threshold": 0.98
        },
        "post_delay": 0,
        "rate_limit": 0
    },
    "AutoStockpileTask": {
        "desc": "开始自动囤货任务",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockpileGotoElasticGoods",
            "AutoStockpileCheckInStore"
        ]
    },
    "AutoStockpileCheckInStore": {
        "desc": "检查商店图标，确认是否位于物资调度",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    50,
                    55,
                    60,
                    70
                ],
                "template": [
                    "AutoStockpile/StableGoodsButtonSelected.png"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "focus": {
            "Node.Recognition.Succeeded": "该地区未解锁弹性物资调度，跳过该地区"
        }
    },
    "AutoStockpileGotoElasticGoods": {
        "desc": "选择弹性物资调度",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AutoStockpileElasticGoodsButton"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click",
            "param": {}
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockpileEnsureElasticTab"
        ]
    },
    "AutoStockpileFindMarketSidebar": {
        "desc": "识别侧边栏市场图标",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    15,
                    140,
                    55,
                    500
                ],
                "template": [
                    "AutoStockpile/ElasticGoodsButtonSide.png"
                ],
                "threshold": [
                    0.8
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "AutoStockpileElasticGoods": {
        "desc": "弹性物资调度未选中",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    340,
                    56,
                    162,
                    116
                ],
                "template": [
                    "AutoStockpile/ElasticGoodsButton.png"
                ],
                "threshold": [
                    0.8
                ]
            }
        }
    },
    "AutoStockpileElasticGoodsSelected": {
        "desc": "弹性物资调度选中",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    340,
                    56,
                    162,
                    116
                ],
                "template": [
                    "AutoStockpile/ElasticGoodsButtonSelected.png"
                ],
                "threshold": [
                    0.8
                ]
            }
        }
    },
    "AutoStockpileEnaureElasticClicked": {
        "desc": "确保成功点击了弹性物资调度",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    15,
                    140,
                    55,
                    500
                ],
                "template": [
                    "AutoStockpile/ElasticGoodsButtonSideSelected.png"
                ],
                "threshold": [
                    0.8
                ]
            }
        },
        "next": [
            "[Anchor]AutoStockpileDecision"
        ]
    }
}
